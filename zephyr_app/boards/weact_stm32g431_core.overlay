/*
 * Space Balloon Ver2 - Device Tree Overlay for WeAct STM32G431CBU6
 *
 * 핀 매핑 (STM32CubeMX 기준):
 *   I2C1:   PA15(SCL), PB9(SDA)  → IMU(LSM6DSV16X), MLX90393, GDK101
 *   I2C3:   PA8(SCL),  PB5(SDA)  → MS5607, SHT3x, MCP9600, CM1107N, SEN0321
 *   USART1: PC4(TX),   PA10(RX)  → GPS (XA1110)
 *   USART2: PA2(TX),   PA3(RX)   → 미세먼지 (PMS3003) [보드 DTS에 정의됨]
 *   USART3: PC10(TX),  PC11(RX)  → 텔레메트리 (LoRa SX1276)
 */

/* I2C1 센서 (Downside Board) */
&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_scl_pa15 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	lsm6dsv16x: lsm6dsv16x@6b {
		compatible = "st,lsm6dsv16x";
		reg = <0x6b>;
	};
};

/* I2C3 센서 (Upside Board) - 주의: 하드웨어는 I2C3 사용 */
&i2c3 {
	status = "okay";
	pinctrl-0 = <&i2c3_scl_pa8 &i2c3_sda_pb5>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;

	ms5607: ms5607@77 {
		compatible = "meas,ms5607";
		reg = <0x77>;
	};

	sht3x: shtcx@44 {
		compatible = "sensirion,shtcx";
		reg = <0x44>;
		measure-mode = "normal";
	};

	mcp9600: mcp9600@60 {
		compatible = "microchip,mcp9600";
		reg = <0x60>;
	};
};

/* USART1 - GPS (XA1110) */
&usart1 {
	status = "okay";
	pinctrl-0 = <&usart1_tx_pc4 &usart1_rx_pa10>;
	pinctrl-names = "default";
	current-speed = <115200>;
};

/* USART2 - 미세먼지 (PMS3003) */
/* pinctrl-0은 보드 DTS에 이미 정의됨 (usart2_tx_pa2, usart2_rx_pa3) */
&usart2 {
	status = "okay";
	current-speed = <9600>;
};

/* USART3 - 텔레메트리 (LoRa SX1276, 115200bps) */
&usart3 {
	status = "okay";
	pinctrl-0 = <&usart3_tx_pc10 &usart3_rx_pc11>;
	pinctrl-names = "default";
	current-speed = <115200>;
};
