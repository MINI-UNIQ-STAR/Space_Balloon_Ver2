// STM32G431CBU6 Platform Definition for Renode
// Standalone platform definition for space balloon radiosonde

// Memory configuration for STM32G431CBU6
// Flash: 128KB, SRAM: 32KB
flash: Memory.MappedMemory @ sysbus 0x8000000
    size: 0x20000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xF0
    systickFrequency: 170000000
    IRQ -> cpu@0

// RCC - Reset and Clock Control (Memory-mapped with default values)
rcc: Memory.MappedMemory @ sysbus 0x40021000
    size: 0x400

// FLASH Controller (Memory-mapped)
flashCtrl: Memory.MappedMemory @ sysbus 0x40022000
    size: 0x400

// PWR - Power Control (Memory-mapped)
pwr: Memory.MappedMemory @ sysbus 0x40007000
    size: 0x400

// TIM2 - 0x40000000
tim2: Timers.STM32_Timer @ sysbus 0x40000000
    frequency: 170000000
    initialLimit: 0xFFFFFFFF
    -> nvic@28

// TIM3 - 0x40000400
tim3: Timers.STM32_Timer @ sysbus 0x40000400
    frequency: 170000000
    initialLimit: 0xFFFF
    -> nvic@29

// TIM6/7 - Basic timers (0x40000400, 0x40001400)
tim6: Timers.STM32_Timer @ sysbus 0x40001000
    frequency: 170000000
    initialLimit: 0xFFFF
    -> nvic@54

tim7: Timers.STM32_Timer @ sysbus 0x40001400
    frequency: 170000000
    initialLimit: 0xFFFF
    -> nvic@55

// I2C1 Bus (Downside sensors)
// Connected sensors: LSM6DSV16X (0x6B), MLX90393 (0x0C), GDK101 (0x18)
i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
    EventInterrupt -> nvic@31
    ErrorInterrupt -> nvic@32

// Note: I2C sensors can be added as separate peripherals
// For now, I2C buses are functional and firmware can communicate

// I2C3 Bus (Upside sensors)
// Connected sensors: SHT31 (0x44), MS5611 (0x77), MCP9600 (0x60)
i2c3: I2C.STM32F7_I2C @ sysbus 0x40007800
    EventInterrupt -> nvic@72
    ErrorInterrupt -> nvic@73

// UART1 - GPS XA1110
usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 200000000
    IRQ -> nvic@37

// UART2 - CM1107N CO2 sensor
usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 200000000
    IRQ -> nvic@38

// UART3 - PMS3003 PM sensor
usart3: UART.STM32F7_USART @ sysbus 0x40004800
    frequency: 200000000
    IRQ -> nvic@39

// ADC1 - Battery voltage monitoring
adc1: Analog.STM32_ADC @ sysbus 0x50000000
    IRQ -> nvic@18

// RTC - Real Time Clock
rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    AlarmIRQ -> nvic@41

// Independent Watchdog
iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 32000
    windowOption: false

// Timers
tim1: Timers.STM32_Timer @ sysbus 0x40012C00
    frequency: 200000000
    initialLimit: 0xFFFF
    -> nvic@24

tim8: Timers.STM32_Timer @ sysbus 0x40013400
    frequency: 200000000
    initialLimit: 0xFFFF
    -> nvic@43

tim16: Timers.STM32_Timer @ sysbus 0x40014400
    frequency: 200000000
    initialLimit: 0xFFFF
    -> nvic@25

// SPI1 - For potential LoRa module
spi1: SPI.STM32SPI @ sysbus 0x40013000
    IRQ -> nvic@35

// DMA1 & DMA2
dma1: DMA.STM32LDMA @ sysbus 0x40020000
    [0-7] -> nvic@[11-17,96]

dma2: DMA.STM32LDMA @ sysbus 0x40020400
    [0-7] -> nvic@[56-60,97-99]

// GPIO banks
gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    modeResetValue: 0xABFFFFFF
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0xFFFFFEBF
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortD: GPIOPort.STM32_GPIOPort @ sysbus <0x48000C00, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

gpioPortF: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>
    modeResetValue: 0xFFFFFFFF
    pullUpPullDownResetValue: 0x00000000
    numberOfAFs: 16
    [0-15] -> exti@[0-15]

exti: IRQControllers.EXTI @ sysbus 0x40010400
    numberOfOutputLines: 43
    [0-4] -> nvic@[6-10]
    [5-9] -> nvicInput23@[0-4]
    [10-15] -> nvicInput40@[0-5]

nvicInput23: Miscellaneous.CombinedInput @ none
    numberOfInputs: 5
    -> nvic@23

nvicInput40: Miscellaneous.CombinedInput @ none
    numberOfInputs: 6
    -> nvic@40

sysbus:
    init:
        Tag <0x58004800 0x3FF> "CRC" 0xFFFFFFFF
