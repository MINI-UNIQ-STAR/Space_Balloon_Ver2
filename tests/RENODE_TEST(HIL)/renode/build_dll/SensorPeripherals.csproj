<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>SensorPeripherals</AssemblyName>
    <RootNamespace>Antmicro.Renode.Peripherals</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutDir>bin/</OutDir>
  </PropertyGroup>

  <!-- Renode Linux path -->
  <PropertyGroup>
    <RenodePath>/opt/renode_1.15.3_portable/bin</RenodePath>
  </PropertyGroup>

  <!-- Renode DLL 참조 -->
  <ItemGroup>
    <Reference Include="Renode">
      <HintPath>$(RenodePath)/Renode.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Antmicro.Renode">
      <HintPath>$(RenodePath)/Antmicro.Renode.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Core">
      <HintPath>$(RenodePath)/Antmicro.Renode.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Peripherals">
      <HintPath>$(RenodePath)/Antmicro.Renode.Peripherals.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Antmicro.Renode.Logging">
      <HintPath>$(RenodePath)/Antmicro.Renode.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 센서 C# 파일들 포함 -->
  <ItemGroup>
    <Compile Include="..\sensors\ms5611_i2c.cs" Link="sensors\ms5611_i2c.cs" />
    <Compile Include="..\sensors\cm1107n_i2c.cs" Link="sensors\cm1107n_i2c.cs" />
    <Compile Include="..\sensors\lsm6dsv16x_i2c.cs" Link="sensors\lsm6dsv16x_i2c.cs" />
    <Compile Include="..\sensors\sht31d_i2c.cs" Link="sensors\sht31d_i2c.cs" />
    <Compile Include="..\sensors\sen0321_i2c.cs" Link="sensors\sen0321_i2c.cs" />
    <Compile Include="..\sensors\mcp9600_i2c.cs" Link="sensors\mcp9600_i2c.cs" />
    <Compile Include="..\sensors\gdk101_i2c.cs" Link="sensors\gdk101_i2c.cs" />
    <Compile Include="..\sensors\mlx90393_i2c.cs" Link="sensors\mlx90393_i2c.cs" />
  </ItemGroup>

  <!-- 경고 억제 -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS0618;CS0612</NoWarn>
  </PropertyGroup>

</Project>
