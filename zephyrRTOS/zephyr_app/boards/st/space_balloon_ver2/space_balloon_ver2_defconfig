# Space Balloon Ver2 - Default Configuration
# STM32G431CBU6 (Cortex-M4F, 128KB Flash, 32KB RAM)

# MCU
CONFIG_SOC_SERIES_STM32G4X=y
CONFIG_SOC_STM32G431XX=y

# Clock (170MHz)
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=170000000
CONFIG_CLOCK_STM32_SYSCLK_SRC_PLL=y
CONFIG_CLOCK_STM32_PLL_SRC_HSE=y
CONFIG_CLOCK_STM32_HSE_CLOCK=24000000

# Console
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y

# Logging
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_BACKEND_UART=y

# GPIO
CONFIG_GPIO=y

# I2C
CONFIG_I2C=y
CONFIG_I2C_STM32=y
CONFIG_I2C_STM32_INTERRUPT=y

# PWM
CONFIG_PWM=y
CONFIG_PWM_STM32=y

# ADC
CONFIG_ADC=y
CONFIG_ADC_STM32=y

# RTOS
CONFIG_MULTITHREADING=y
CONFIG_NUM_COOP_PRIORITIES=16
CONFIG_NUM_PREEMPT_PRIORITIES=16

# Heap
CONFIG_HEAP_MEM_POOL_SIZE=2048

# Debug
CONFIG_DEBUG=y
CONFIG_ASSERT=y

# Watchdog (optional)
# CONFIG_WATCHDOG=y
# CONFIG_WDT_STM32=y
